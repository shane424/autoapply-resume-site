ANTHROPIC_API_KEY=sk-ant-...

# Full path to your PRIMARY resume PDF or DOCX — auto-loaded at server startup.
# This should be your current targeted resume (has your most recent job).
# Windows example:  RESUME_PATH=C:/Users/Shane/Documents/Resume/Shane_Smith.pdf
RESUME_PATH=

# Full path to your CAREER POOL resume — all jobs, all bullets, entire career history.
# The AI draws from this as a source pool when tailoring — picking the most relevant
# jobs and bullets for each application. Leave blank to use only the primary resume.
# Windows example:  CAREER_RESUME_PATH=C:/Users/Shane/Documents/Resume/Shane_Smith_base_entire_career_2026.pdf
CAREER_RESUME_PATH=
