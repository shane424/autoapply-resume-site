ANTHROPIC_API_KEY=sk-ant-...

# Full path to your PRIMARY resume PDF or DOCX — auto-loaded at server startup.
# Windows example:  RESUME_PATH=C:/Users/Shane/Documents/Resume/Shane_Smith.pdf
RESUME_PATH=

# Full path to your CAREER POOL resume — all jobs + bullets, entire career history.
# Windows example:  CAREER_RESUME_PATH=C:/Users/Shane/Documents/Resume/Shane_Smith_base_entire_career_2026.pdf
CAREER_RESUME_PATH=

# Folder where finished PDF + DOCX files are copied after each tailor run.
# A subfolder named after the company + date is created automatically inside this folder.
# Windows example:  OUTPUT_DIR=C:/Users/Shane/Documents/Resume/2026/AIGenerated
OUTPUT_DIR=
